
.cell.range-selected::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(26, 115, 232, 0.15); /* Light blue overlay */
  pointer-events: none;
  z-index: 2;
}

.cell.selected {
  outline: 2px solid #1a73e8; /* Use outline to sit above neighbors? or border */
  border: 1px solid transparent; /* Hide default border? */
  z-index: 5 !important;
}
